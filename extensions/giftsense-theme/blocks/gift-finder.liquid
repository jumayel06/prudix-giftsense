{% comment %}
  GiftSense "Find a gift" block: a heading + button merchants place in any
  section (home, collection, product pages). Opens the same finder as the
  app embed launcher; works with or without the embed turned on.
{% endcomment %}
{%- assign gs_lang = request.locale.iso_code | split: '-' | first | downcase -%}
{%- comment -%} Widget text file for the storefront's language (assets/giftsense-i18n-<lang>.js); English needs none. {%- endcomment -%}
{%- if gs_lang == 'es' or gs_lang == 'fr' or gs_lang == 'de' or gs_lang == 'it' or gs_lang == 'pt' -%}
  {%- assign gs_i18n_file = 'giftsense-i18n-' | append: gs_lang | append: '.js' -%}
  {%- assign gs_i18n = gs_i18n_file | asset_url -%}
{%- endif -%}
{%- comment -%} Button look from the block's Button settings (styled by assets/giftsense-buttons.css). Kept inline: Shopify wraps app snippet output in HTML comments, which break a tag or attribute they land in. {%- endcomment -%}
{%- liquid
  case block.settings.btn_style
    when 'filled', 'outline', 'link'
      assign gs_style = block.settings.btn_style
    when 'theme_primary', 'theme_secondary'
      assign gs_style = 'theme'
    else
      assign gs_style = 'auto'
  endcase
  case block.settings.btn_size
    when 'small'
      assign gs_pad = '8px 14px'
    when 'large'
      assign gs_pad = '16px 28px'
    else
      assign gs_pad = '12px 20px'
  endcase
-%}
{%- capture gs_btn_class -%}gs-btn gs-s-{{ gs_style }} gs-k-filled{% if block.settings.btn_width == 'full' %} gs-btn--full{% endif %}{% if block.settings.btn_shadow %} gs-btn--shadow{% endif %}{% if block.settings.btn_style == 'theme_primary' %} button btn{% elsif block.settings.btn_style == 'theme_secondary' %} button button--secondary btn btn--secondary{% endif %}{%- endcapture -%}
{%- capture gs_btn_style -%}--gs-btn-case: {{ block.settings.btn_case | default: 'none' }};{% if gs_style == 'filled' or gs_style == 'outline' or gs_style == 'link' %} --gs-btn-bg: {{ block.settings.btn_bg }}; --gs-btn-fg: {{ block.settings.btn_text }}; --gs-btn-radius: {{ block.settings.btn_radius }}px; --gs-btn-fs: {{ block.settings.btn_font_size }}px; --gs-btn-fw: {{ block.settings.btn_weight }}; --gs-btn-bw: {{ block.settings.btn_border }}px; --gs-btn-pad: {{ gs_pad }};{% endif %}{%- endcapture -%}
{%- capture gs_accent -%}{% if gs_style == 'filled' or gs_style == 'outline' or gs_style == 'link' %}--gs-accent: {{ block.settings.btn_bg }}; --gs-on-accent: {{ block.settings.btn_text }};{% else %}--gs-accent: rgb(var(--color-button, 17, 24, 39)); --gs-on-accent: rgb(var(--color-button-text, 255, 255, 255));{% endif %}{%- endcapture -%}
{%- comment -%} Line icon before the button text (Button setting "Icon"). {%- endcomment -%}
{%- capture gs_icon -%}{% case block.settings.btn_icon %}{% when 'gift' %}<svg class="gs-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9z"/><path d="M3 7h18v4H3z"/><path d="M12 7v14"/><path d="M12 7c-1.5-3-5-3.5-5-1.25C7 7 9.5 7 12 7zm0 0c1.5-3 5-3.5 5-1.25C17 7 14.5 7 12 7z"/></svg>{% when 'heart' %}<svg class="gs-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>{% when 'sparkle' %}<svg class="gs-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg>{% endcase %}{%- endcapture -%}
{{ 'giftsense-buttons.css' | asset_url | stylesheet_tag }}
<div
  class="giftsense-block"
  data-giftsense-root
  data-giftsense-inline
  data-api="/apps/giftsense"
  data-ui-src="{{ 'giftsense-ui.js' | asset_url }}"
  data-css-src="{{ 'giftsense.css' | asset_url }}"
  data-cart-src="{{ 'giftsense-cart.js' | asset_url }}"
  data-currency="{{ shop.currency }}"
  data-locale="{{ request.locale.iso_code }}"
  {% if gs_i18n %}data-i18n-src="{{ gs_i18n }}"{% endif %}
  style="{{ gs_accent }} text-align: {{ block.settings.align }};"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Merchant text escaped here; `t` output is already escaped. {%- endcomment -%}
  {%- assign gs_heading = block.settings.heading | escape -%}
  {%- if block.settings.heading == "Not sure what to get?" -%}{%- assign gs_heading = 'finder.heading' | t -%}{%- endif -%}
  {%- assign gs_text = block.settings.text | escape -%}
  {%- if block.settings.text == "Answer a few quick questions and we'll suggest gifts from our store." -%}{%- assign gs_text = 'finder.text' | t -%}{%- endif -%}
  {%- assign gs_button = block.settings.button | escape -%}
  {%- if block.settings.button == blank or block.settings.button == 'Find a gift' -%}{%- assign gs_button = 'launcher' | t -%}{%- endif -%}
  {% if gs_heading != blank %}<h2 class="giftsense-block__heading">{{ gs_heading }}</h2>{% endif %}
  {% if gs_text != blank %}<p class="giftsense-block__text">{{ gs_text }}</p>{% endif %}
  <div style="text-align: {{ block.settings.btn_align }};">
    <button type="button" class="{{ gs_btn_class }} giftsense-block__button" style="{{ gs_btn_style }}" data-giftsense-open>
      {{- gs_icon -}}<span>{{ gs_button }}</span>
    </button>
  </div>
</div>
<script src="{{ 'giftsense.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Find a gift",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure what to get?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answer a few quick questions and we'll suggest gifts from our store."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button text",
      "default": "Find a gift"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Style",
      "default": "auto",
      "info": "\"Match my theme\" picks up your theme's button colors, font and corners. Choose Filled, Outline or Text link to set your own; the color, size and shape settings below apply to those.",
      "options": [
        {
          "value": "auto",
          "label": "Match my theme (recommended)"
        },
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "Text link"
        },
        {
          "value": "theme_primary",
          "label": "Use my theme's button"
        },
        {
          "value": "theme_secondary",
          "label": "Use my theme's secondary button"
        }
      ]
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button color",
      "default": "#111827",
      "info": "For Filled, Outline and Text link. Also the highlight color in the gift finder."
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text color",
      "default": "#ffffff",
      "info": "For Filled and Outline (on hover)."
    },
    {
      "type": "select",
      "id": "btn_icon",
      "label": "Icon",
      "default": "gift",
      "options": [
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn_size",
      "label": "Size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "btn_weight",
      "label": "Text weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn_case",
      "label": "Letter case",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize Each Word"
        }
      ]
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40,
      "info": "0 for square corners, 40 for fully rounded."
    },
    {
      "type": "range",
      "id": "btn_border",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "btn_shadow",
      "label": "Shadow",
      "default": false
    },
    {
      "type": "select",
      "id": "btn_width",
      "label": "Width",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Fit the text"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "select",
      "id": "btn_align",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ]
}
{% endschema %}
