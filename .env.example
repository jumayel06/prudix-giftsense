# GiftSense local environment. Copy to `.env` and fill in (`.env` is gitignored).
# Mirrors Prudix Commerce's .env.example.
#
# Source-of-truth rule (from Commerce's release checklist):
#   - Local `.env`      = DEV-ONLY credentials (GiftSense (Dev) app, dev Supabase, dev Redis, dev keys)
#   - Railway env vars  = PROD-ONLY credentials. Never copy prod values into this file.

# ── Shopify: GiftSense (Dev) app, jumayel006@ Partner account ────────────────
SHOPIFY_API_KEY=2ea88886e5ce1368a9ddfdf8d83cc171
# Partner Dashboard → GiftSense (Dev) → Client credentials → Secret
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07

# Public host this backend is reachable at. Builds absolute URLs (billing
# return URL, OAuth redirect_uri). REQUIRED, no code fallback: an empty value
# fails loudly instead of guessing. (Commerce's old toml-guessing fallback sent a
# prod billing callback to the dev tunnel.) Local = the named Cloudflare tunnel.
APP_HOST=giftsense-dev.prudix.app

# The {handle} in admin.shopify.com/store/<shop>/apps/<handle>/ for the DEV app.
# Used for deep links in digest emails. Copy it from the admin URL after install.
SHOPIFY_APP_HANDLE=

# Forces Shopify Billing API charges to `test: true` on production. Non-prod is
# always test regardless. MUST be false (or unset) in Railway at App Store submission.
BILLING_TEST_MODE=false

# ── Database: Supabase `prudix-giftsense-dev` (vector extension enabled) ─────
# App runtime connection. Locally use the SESSION pooler (port 5432). Supabase →
# Connect → Session pooler, then change the scheme to postgresql+asyncpg and add
# ?ssl=require:
#   postgresql+asyncpg://postgres.<project-ref>:<PASSWORD>@aws-1-us-east-2.pooler.supabase.com:5432/postgres?ssl=require
# In PROD (Railway) this points at the TRANSACTION pooler (port 6543) instead;
# core/db/session.py uses NullPool + disabled statement caches so 6543 is safe.
DATABASE_URL=

# Dedicated connection for Alembic MIGRATIONS only (session pooler, port 5432).
# Optional locally (falls back to DATABASE_URL); REQUIRED in prod.
DIRECT_DATABASE_URL=

# ── Redis (ARQ job queue) ─────────────────────────────────────────────────────
# Local Redis (`brew services start redis`). Database index /1 because Prudix
# Commerce uses /0 on the same local Redis, and both ARQ workers use the
# default queue name. Sharing a database would let each worker pick up the
# other's jobs. Prod uses its own Upstash DB (rediss://, double s = TLS):
#   rediss://default:<TOKEN>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/1

# ── LLM providers (dev keys) ──────────────────────────────────────────────────
# OpenAI: GPT-6 Luna / GPT-6 Sol, embeddings (text-embedding-3-small), moderation.
OPENAI_API_KEY=
# Anthropic: Claude Haiku 4.5 / Sonnet 5.
ANTHROPIC_API_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# Fernet key for encrypting Shopify tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Prod gets its own fresh key. Rotating it invalidates every stored token.
TOKEN_ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# REQUIRED: development | production | test. Drives /docs and /debug gating,
# CORS, and JSON logging.
APP_ENV=development

# Internal admin dashboard (/admin/*, HTTP Basic Auth). admin/admin is fine locally;
# prod uses a non-obvious username + `openssl rand -base64 24`.
INTERNAL_ADMIN_USERNAME=admin
INTERNAL_ADMIN_PASSWORD=admin

# Per-shop daily LLM cost backstop (USD), used only when a plan doesn't set its
# own daily_cost_cap_usd. 0 disables it. Resets at UTC midnight.
MAX_DAILY_COST_USD_PER_SHOP=20.0

# Fixed monthly infra estimate for the admin profit page.
MONTHLY_INFRA_COST_USD=70

# App Store listing slug (after apps.shopify.com/). Leave EMPTY until Shopify
# approves the listing; the "leave a review" prompt stays off until then.
APP_STORE_LISTING_SLUG=

# ── Observability ─────────────────────────────────────────────────────────────
# Blank disables Sentry locally. Prod uses a separate Sentry project.
SENTRY_DSN=
# Issues-page URL for the admin "Errors ↗" link. Blank hides the link.
SENTRY_PROJECT_URL=

# ── Email: Postmark (weekly sales email) ──────────────────────────────────────
# If empty, the digest worker logs the email instead of sending it.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=digest@prudix.app
# Basic Auth for the Postmark bounce/complaint webhook. Blank locally = no auth.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# ── Media storage: Cloudflare R2 (voice/video messages, needed from week 6) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=giftsense-dev-media
