# Merchant dashboard (Vite) environment. Copy to `dashboard/.env` (gitignored).
# Mirrors Prudix Commerce's dashboard/.env.example.

# Client ID of the Shopify app the dashboard talks to. Baked into App Bridge's
# <script data-api-key="..."> through Vite HTML env substitution in index.html.
#   - Local dev:     dev app client_id (GiftSense (Dev)), shown below
#   - Railway prod:  prod app client_id b538375f0b27e0640a535a12fe64c41f, set as a
#                    Railway BUILD-time variable, never here
VITE_SHOPIFY_API_KEY=2ea88886e5ce1368a9ddfdf8d83cc171

# Dev fallback shop domain, used only when no App Bridge session token is
# available (never inside a real merchant install). Leave empty in prod builds.
VITE_SHOP=prudix-commerce-dev.myshopify.com
